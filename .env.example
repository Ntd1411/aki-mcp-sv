# Copy to .env and uncomment/edit what you need — start.js loads it automatically.
# Every value below is optional; the defaults shown are what start.js already uses.

# Public HTTPS URL for your own edge (bypasses Tailscale Funnel when set).
# PUBLIC_ORIGIN=https://mcp.yourdomain.com

# Gatekeeper & OAuth listen port.
# GATEKEEPER_PORT=9999

# Config web UI listen port.
# PANEL_PORT=9998

# Workspace root directory exposed to the MCP tools.
# MCP_DATA_DIR=/path/to/your/workspace

# MCP request timeout, in milliseconds (default 600000 = 10 minutes).
# MCP_REQUEST_TIMEOUT_MS=600000

# Cloudflare tunnel credentials file (the JSON carrying a TunnelID, from `cloudflared tunnel
# create`). When set, start.js spawns and supervises cloudflared itself and Tailscale is never
# consulted; PUBLIC_ORIGIN supplies the hostname the credentials file does not carry.
# CLOUDFLARED_CRED=/home/you/.cloudflared/<tunnel-id>.json

# Set to 1 to never auto-open the panel in a browser at startup (tray/headless setups).
# MCP_SKIP_BROWSER_OPEN=1
